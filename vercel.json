{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw\\.js|sw-rollover\\.js|manifest\\.webmanifest|index\\.html|boot-watchdog\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/store/products",
      "destination": "/api/store/products"
    },
    {
      "source": "/api/store/categories",
      "destination": "/api/store/categories"
    },
    {
      "source": "/api/bots",
      "destination": "/api/bots"
    },
    {
      "source": "/api/bots/categories",
      "destination": "/api/bots/categories"
    },
    {
      "source": "/api/live/streams",
      "destination": "/api/live/streams"
    },
    {
      "source": "/api/live/channels/me",
      "destination": "/api/live/channels/me"
    },
    {
      "source": "/api/live/channels/link",
      "destination": "/api/live/channels/link"
    },
    {
      "source": "/api/:path*",
      "destination": "https://167-234-239-100.sslip.io/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|icons/|fonts/|wasm/|worklets/|winks/|sw\\.js|sw-rollover\\.js|manifest\\.webmanifest|boot-watchdog\\.js|favicon\\.svg|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
