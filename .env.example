# ============================================================
# CONCORD — Configuração de Ambiente (.env)
# ============================================================
# Copie este arquivo para .env e preencha as variáveis de configuração.

# Domínio público ou endereço da instância (ex: chat.meudominio.com)
DOMAIN=chat.meudominio.com

# Modo de implantação:
#   allinone (padrão) — Caddy gerencia portas 80/443 e certificados SSL automáticos Let's Encrypt
#   proxy            — Para uso com proxy reverso existente (Nginx, Traefik, etc.)
#   tunnel           — Para uso com túneis (Cloudflare Tunnel, Tailscale, etc.)
DEPLOY_MODE=allinone

# Chave secreta JWT (mínimo de 32 caracteres)
# Gere no terminal com: openssl rand -hex 32
JWT_SECRET=substitua_por_uma_chave_secreta_jwt_forte_de_pelo_menos_32_caracteres

# Duração do token de sessão (padrão: 30 dias)
JWT_EXPIRES_IN=30d

# ─── Banco de Dados e Armazenamento ─────────────────────────
# Banco SQLite persistente e diretório de arquivos enviados
DB_PATH=/app/data/concord.db
UPLOAD_DIR=/app/data/uploads

# Tamanho máximo de upload em bytes (padrão: 100MB = 104857600)
MAX_UPLOAD_SIZE=104857600

# Cadastro público aberto (true) ou somente por convite (false)
REGISTRATION_OPEN=true

# ─── LiveKit: Voz, Vídeo e Compartilhamento de Tela ────────
# Para ativar o servidor LiveKit SFU em conjunto com o Concord:
COMPOSE_PROFILES=voice
LIVEKIT_URL=wss://chat.meudominio.com/livekit
LIVEKIT_API_KEY=concord_key
LIVEKIT_API_SECRET=substitua_por_uma_chave_secreta_forte_para_o_livekit

# ─── Concord Desktop (Electron) ─────────────────────────────
# URL que o cliente desktop carrega ao iniciar
CONCORD_URL=https://chat.meudominio.com

# ─── Backups Automáticos do Banco de Dados ─────────────────
BACKUP_DIR=/app/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_SCHEDULED=7
BACKUP_KEEP_PREMIGRATION=5
BACKUP_KEEP_MANUAL=10
